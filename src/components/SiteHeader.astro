<header class="sticky top-0 z-50 border-b border-line/80 bg-cream/90 backdrop-blur-xl">
	<div class="mx-auto flex h-20 w-full max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
		<a href="#top" class="flex items-center gap-3">
			<span class="grid size-11 place-items-center rounded-2xl bg-clay text-white shadow-lg shadow-clay/25">
				<svg viewBox="0 0 40 40" class="size-6" fill="none" aria-hidden="true">
					<path
						d="M7 14h22l-5-5M33 26H11l5 5"
						stroke="currentColor"
						stroke-width="2.6"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
				</svg>
			</span>
			<span class="flex flex-col leading-tight">
				<span class="text-lg font-extrabold tracking-tight text-ink">EduTransfer</span>
				<span class="text-[10px] font-bold uppercase tracking-[0.18em] text-ink-soft">
					Teacher Transfer Portal
				</span>
			</span>
		</a>

		<nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation">
			<a
				href="#top"
				class="text-sm font-bold text-ink-soft transition-colors hover:text-clay"
			>
				Overview
			</a>
			<a
				href="#apply"
				class="text-sm font-bold text-ink-soft transition-colors hover:text-clay"
			>
				Apply
			</a>
			<a
				href="#contact"
				class="text-sm font-bold text-ink-soft transition-colors hover:text-clay"
			>
				Support
			</a>
		</nav>

		<div class="flex items-center gap-2">
			<a
				href="#apply"
				class="hidden items-center gap-2 rounded-xl bg-clay px-5 py-3 text-sm font-extrabold text-white shadow-lg shadow-clay/20 transition hover:-translate-y-0.5 hover:bg-clay-dark sm:inline-flex"
			>
				Start application
				<svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
					<path
						d="M4 10h12m-5-5 5 5-5 5"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
			<button
				type="button"
				data-menu-toggle
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="grid size-11 place-items-center rounded-xl border border-line bg-white text-ink transition hover:border-clay/40 hover:text-clay lg:hidden"
			>
				<span class="sr-only">Open navigation menu</span>
				<svg data-menu-open viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true">
					<path
						d="M4 7h16M4 12h16M4 17h16"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"></path>
				</svg>
				<svg
					data-menu-close
					viewBox="0 0 24 24"
					class="hidden size-5"
					fill="none"
					aria-hidden="true"
				>
					<path
						d="m6 6 12 12M18 6 6 18"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
	</div>

	<div
		id="mobile-menu"
		data-menu
		class="hidden border-t border-line/80 bg-cream px-5 pb-6 pt-4 lg:hidden"
	>
		<nav class="flex flex-col gap-1" aria-label="Mobile navigation">
			<a
				href="#top"
				class="rounded-xl px-4 py-3 text-sm font-bold text-ink-soft transition hover:bg-white hover:text-clay"
			>
				Overview
			</a>
			<a
				href="#apply"
				class="rounded-xl px-4 py-3 text-sm font-bold text-ink-soft transition hover:bg-white hover:text-clay"
			>
				Apply
			</a>
			<a
				href="#contact"
				class="rounded-xl px-4 py-3 text-sm font-bold text-ink-soft transition hover:bg-white hover:text-clay"
			>
				Support
			</a>
		</nav>
		<a
			href="#apply"
			class="mt-3 flex items-center justify-center gap-2 rounded-xl bg-clay px-5 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-clay/20 transition hover:bg-clay-dark"
		>
			Start application
			<svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
				<path
					d="M4 10h12m-5-5 5 5-5 5"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</div>
</header>

<script>
	const toggle = document.querySelector('[data-menu-toggle]');
	const menu = document.querySelector('[data-menu]');
	const openIcon = document.querySelector('[data-menu-open]');
	const closeIcon = document.querySelector('[data-menu-close]');

	if (toggle && menu) {
		const setMenuState = (isOpen) => {
			toggle.setAttribute('aria-expanded', String(isOpen));
			menu.classList.toggle('hidden', !isOpen);
			openIcon?.classList.toggle('hidden', isOpen);
			closeIcon?.classList.toggle('hidden', !isOpen);
		};

		toggle.addEventListener('click', () => {
			setMenuState(toggle.getAttribute('aria-expanded') !== 'true');
		});

		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setMenuState(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				setMenuState(false);
				toggle.focus();
			}
		});

		window.addEventListener('resize', () => {
			if (window.innerWidth >= 1024) setMenuState(false);
		});
	}
</script>
