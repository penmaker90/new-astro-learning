---
const fieldClass =
	'w-full rounded-xl border border-line bg-cream/60 px-4 py-3 text-sm font-semibold text-ink shadow-sm transition placeholder:font-normal placeholder:text-ink-soft/50 focus:border-clay focus:bg-white focus:outline-none focus:ring-4 focus:ring-clay/10';
const labelClass = 'mb-2 block text-sm font-bold text-ink';
const errorClass = 'mt-1.5 hidden text-xs font-bold text-red-700';

const checklist = [
	'Have your employee ID ready',
	'Choose your preferred district',
	'Read the transfer eligibility policy',
	'Prepare a short reason for your request',
];
---

<section id="apply" class="scroll-mt-24 border-y border-line/70 bg-sand/30 py-16 lg:py-24">
	<div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
		<div class="max-w-2xl animate-rise">
			<p class="text-xs font-extrabold uppercase tracking-[0.18em] text-clay">Application</p>
			<h2 class="mt-3 font-display text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl">
				Let’s find your next school.
			</h2>
			<p class="mt-4 text-lg leading-8 text-ink-soft">
				Tell us a little about you and where you’d like to teach. The form takes about five
				minutes, and you can save a copy of your answers before submitting.
			</p>
		</div>

		<div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
			<div
				class="rounded-[2rem] border border-line bg-white p-6 shadow-xl shadow-ink/5 sm:p-9"
			>
				<div class="flex flex-wrap items-center justify-between gap-3 border-b border-line/80 pb-6">
					<div>
						<h3 class="font-display text-2xl font-semibold text-ink">Transfer request</h3>
						<p class="mt-1 text-sm font-semibold text-ink-soft">
							Fields marked with <span class="text-clay">*</span> are required.
						</p>
					</div>
					<span
						class="rounded-full bg-clay-soft px-3 py-1 text-[10px] font-extrabold uppercase tracking-[0.14em] text-clay-dark"
					>
						Demo form
					</span>
				</div>

				<div
					id="form-error"
					role="alert"
					hidden
					class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-800"
				>
				</div>

				<form id="transfer-form" class="mt-8 space-y-9">
					<fieldset class="space-y-5">
						<legend class="flex w-full items-center gap-3 text-base font-extrabold text-ink">
							<span class="grid size-8 place-items-center rounded-full bg-clay-soft text-xs font-extrabold text-clay-dark">
								1
							</span>
							About you
						</legend>

						<div class="grid gap-5 sm:grid-cols-2">
							<div>
								<label for="fullName" class={labelClass}>
									Full name <span class="text-clay" aria-hidden="true">*</span>
								</label>
								<input
									id="fullName"
									name="fullName"
									type="text"
									autocomplete="name"
									required
									minlength="2"
									placeholder="e.g. Amara Okafor"
									class={fieldClass}
									aria-describedby="fullName-error"
								/>
								<p id="fullName-error" class={errorClass}></p>
							</div>

							<div>
								<label for="email" class={labelClass}>
									Email address <span class="text-clay" aria-hidden="true">*</span>
								</label>
								<input
									id="email"
									name="email"
									type="email"
									autocomplete="email"
									required
									placeholder="you@example.com"
									class={fieldClass}
									aria-describedby="email-error"
								/>
								<p id="email-error" class={errorClass}></p>
							</div>

							<div>
								<label for="phone" class={labelClass}>
									Phone number <span class="text-clay" aria-hidden="true">*</span>
								</label>
								<input
									id="phone"
									name="phone"
									type="tel"
									autocomplete="tel"
									required
									placeholder="e.g. +1 555 0142"
									class={fieldClass}
									aria-describedby="phone-error"
								/>
								<p id="phone-error" class={errorClass}></p>
							</div>

							<div>
								<label for="employeeId" class={labelClass}>
									Employee ID <span class="text-clay" aria-hidden="true">*</span>
								</label>
								<input
									id="employeeId"
									name="employeeId"
									type="text"
									required
									pattern="[A-Za-z0-9\-]{4,}"
									placeholder="e.g. TCH-4821"
									class={fieldClass}
									aria-describedby="employeeId-help employeeId-error"
								/>
								<p id="employeeId-help" class="mt-1.5 text-xs font-semibold text-ink-soft">
									Letters, numbers, and hyphens only.
								</p>
								<p id="employeeId-error" class={errorClass}></p>
							</div>
						</div>
					</fieldset>

					<fieldset class="space-y-5 border-t border-line/80 pt-8">
						<legend class="flex w-full items-center gap-3 text-base font-extrabold text-ink">
							<span class="grid size-8 place-items-center rounded-full bg-clay-soft text-xs font-extrabold text-clay-dark">
								2
							</span>
							Your transfer request
						</legend>

						<div class="grid gap-5 sm:grid-cols-2">
							<div>
								<label for="currentSchool" class={labelClass}>
									Current school <span class="text-clay" aria-hidden="true">*</span>
								</label>
								<input
									id="currentSchool"
									name="currentSchool"
									type="text"
									required
									placeholder="e.g. Riverside Primary"
									class={fieldClass}
									aria-describedby="currentSchool-error"
								/>
								<p id="currentSchool-error" class={errorClass}></p>
							</div>

							<div>
								<label for="currentRegion" class={labelClass}>
									Current district <span class="text-clay" aria-hidden="true">*</span>
								</label>
								<select
									id="currentRegion"
									name="currentRegion"
									required
									class={fieldClass}
									aria-describedby="currentRegion-error"
								>
									<option value="">Select a district</option>
									<option>North District</option>
									<option>South District</option>
									<option>East District</option>
									<option>West District</option>
									<option>Central District</option>
								</select>
								<p id="currentRegion-error" class={errorClass}></p>
							</div>

							<div>
								<label for="preferredSchool" class={labelClass}>
									Preferred school <span class="text-clay" aria-hidden="true">*</span>
								</label>
								<input
									id="preferredSchool"
									name="preferredSchool"
									type="text"
									required
									placeholder="e.g. Meadowbrook Primary"
									class={fieldClass}
									aria-describedby="preferredSchool-error"
								/>
								<p id="preferredSchool-error" class={errorClass}></p>
							</div>

							<div>
								<label for="preferredRegion" class={labelClass}>
									Preferred district <span class="text-clay" aria-hidden="true">*</span>
								</label>
								<select
									id="preferredRegion"
									name="preferredRegion"
									required
									class={fieldClass}
									aria-describedby="preferredRegion-error"
								>
									<option value="">Select a district</option>
									<option>North District</option>
									<option>South District</option>
									<option>East District</option>
									<option>West District</option>
									<option>Central District</option>
								</select>
								<p id="preferredRegion-error" class={errorClass}></p>
							</div>

							<div>
								<label for="role" class={labelClass}>
									Role or grade level <span class="text-clay" aria-hidden="true">*</span>
								</label>
								<select
									id="role"
									name="role"
									required
									class={fieldClass}
									aria-describedby="role-error"
								>
									<option value="">Select a role</option>
									<option>Primary teacher</option>
									<option>Secondary teacher</option>
									<option>Special education teacher</option>
									<option>School leader</option>
									<option>Other</option>
								</select>
								<p id="role-error" class={errorClass}></p>
							</div>

							<div>
								<label for="years" class={labelClass}>
									Years of service <span class="text-clay" aria-hidden="true">*</span>
								</label>
								<input
									id="years"
									name="years"
									type="number"
									required
									min="0"
									max="50"
									inputmode="numeric"
									placeholder="e.g. 6"
									class={fieldClass}
									aria-describedby="years-error"
								/>
								<p id="years-error" class={errorClass}></p>
							</div>
						</div>
					</fieldset>

					<fieldset class="space-y-5 border-t border-line/80 pt-8">
						<legend class="flex w-full items-center gap-3 text-base font-extrabold text-ink">
							<span class="grid size-8 place-items-center rounded-full bg-clay-soft text-xs font-extrabold text-clay-dark">
								3
							</span>
							Reason and declaration
						</legend>

						<div>
							<label for="reason" class={labelClass}>
								Why would you like to transfer? <span class="text-clay" aria-hidden="true">*</span>
							</label>
							<textarea
								id="reason"
								name="reason"
								rows="4"
								required
								minlength="20"
								placeholder="Tell us about your preferred location, timing, or circumstances."
								class={fieldClass}
								aria-describedby="reason-help reason-error"></textarea>
							<p id="reason-help" class="mt-1.5 text-xs font-semibold text-ink-soft">
								A short note is enough — at least 20 characters.
							</p>
							<p id="reason-error" class={errorClass}></p>
						</div>

						<div class="rounded-2xl border border-line bg-cream/60 p-4 sm:p-5">
							<div class="flex items-start gap-3">
								<input
									id="declaration"
									name="declaration"
									type="checkbox"
									required
									class="mt-1 size-5 shrink-0 rounded border-line accent-clay focus:ring-clay/30"
									aria-describedby="declaration-help declaration-error"
								/>
								<div>
									<label for="declaration" class="text-sm font-bold text-ink">
										I confirm the information above is accurate.
										<span class="text-clay" aria-hidden="true">*</span>
									</label>
									<p id="declaration-help" class="mt-1 text-xs font-semibold leading-relaxed text-ink-soft">
										I understand this is a demonstration form and that no application will be
										submitted.
									</p>
									<p id="declaration-error" class={errorClass}></p>
								</div>
							</div>
						</div>
					</fieldset>

					<div class="border-t border-line/80 pt-7">
						<button
							type="submit"
							class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-clay px-6 py-4 text-sm font-extrabold text-white shadow-xl shadow-clay/25 transition hover:-translate-y-0.5 hover:bg-clay-dark sm:w-auto"
						>
							Submit application
							<svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
								<path
									d="M4 10h12m-5-5 5 5-5 5"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
						<p class="mt-3 flex items-center gap-2 text-xs font-semibold text-ink-soft">
							<svg viewBox="0 0 20 20" class="size-4 shrink-0 text-sage" fill="none" aria-hidden="true">
								<rect
									x="4"
									y="8"
									width="12"
									height="8"
									rx="2"
									stroke="currentColor"
									stroke-width="1.6"></rect>
								<path
									d="M7 8V6a3 3 0 0 1 6 0v2"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"></path>
							</svg>
							Front-end demo only — your information stays in this browser and is never sent.
						</p>
					</div>
				</form>

				<div
					id="form-success"
					role="status"
					aria-live="polite"
					hidden
					class="mt-6 flex items-start gap-3 rounded-2xl border border-sage/30 bg-sage-soft p-4 text-sm font-bold text-sage"
				>
					<span class="grid size-7 shrink-0 place-items-center rounded-full bg-sage text-white">
						<svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
							<path
								d="m5 10 3 3 7-7"
								stroke="currentColor"
								stroke-width="2.2"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</span>
					<p data-success-message>Your demo application is complete — no data was sent.</p>
				</div>
			</div>

			<aside class="space-y-5 lg:sticky lg:top-28" aria-label="Application guidance">
				<div class="rounded-[1.75rem] border border-line bg-white p-6 shadow-lg shadow-ink/5">
					<div class="flex items-center gap-3">
						<span class="grid size-10 place-items-center rounded-xl bg-honey/20 text-clay">
							<svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true">
								<path
									d="M8 5h8a2 2 0 0 1 2 2v12l-6-3-6 3V7a2 2 0 0 1 2-2Z"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linejoin="round"></path>
								<path
									d="m9.5 10 1.7 1.7 3.3-3.4"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</span>
						<h3 class="font-display text-xl font-semibold text-ink">Before you apply</h3>
					</div>
					<ul class="mt-5 space-y-3">
						{
							checklist.map((item) => (
								<li class="flex items-start gap-3 text-sm font-semibold text-ink-soft">
									<span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-sage-soft text-sage">
										<svg viewBox="0 0 20 20" class="size-3" fill="none" aria-hidden="true">
											<path
												d="m5 10 3 3 7-7"
												stroke="currentColor"
												stroke-width="2.4"
												stroke-linecap="round"
												stroke-linejoin="round"></path>
										</svg>
									</span>
									{item}
								</li>
							))
						}
					</ul>
				</div>

				<div class="rounded-[1.75rem] bg-clay p-6 text-white shadow-xl shadow-clay/20">
					<p class="text-[10px] font-extrabold uppercase tracking-[0.18em] text-white/90">Key dates</p>
					<dl class="mt-4 space-y-3 text-sm">
						<div class="flex items-center justify-between gap-4 border-b border-white/20 pb-3">
							<dt class="font-semibold text-white/90">Applications open</dt>
							<dd class="font-extrabold">1 November</dd>
						</div>
						<div class="flex items-center justify-between gap-4 border-b border-white/20 pb-3">
							<dt class="font-semibold text-white/90">Applications close</dt>
							<dd class="font-extrabold">15 December</dd>
						</div>
						<div class="flex items-center justify-between gap-4">
							<dt class="font-semibold text-white/90">Decisions shared</dt>
							<dd class="font-extrabold">12 January</dd>
						</div>
					</dl>
				</div>

				<div class="rounded-[1.75rem] border border-line bg-white p-6 shadow-lg shadow-ink/5">
					<h3 class="font-display text-xl font-semibold text-ink">Need a hand?</h3>
					<p class="mt-2 text-sm font-semibold leading-relaxed text-ink-soft">
						Our teacher support desk is here to help with forms, eligibility, and next steps.
					</p>
					<div class="mt-4 space-y-2">
						<a
							href="mailto:transfers@edutransfer.gov"
							class="flex items-center gap-2 text-sm font-extrabold text-clay hover:text-clay-dark"
						>
							<svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
								<rect
									x="3"
									y="5"
									width="14"
									height="10"
									rx="2"
									stroke="currentColor"
									stroke-width="1.6"></rect>
								<path
									d="m4 6 6 5 6-5"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
							transfers@edutransfer.gov
						</a>
						<a
							href="tel:+18005550142"
							class="flex items-center gap-2 text-sm font-extrabold text-clay hover:text-clay-dark"
						>
							<svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
								<path
									d="M6 3.5h2l1 3-1.5 1a10 10 0 0 0 5 5l1-1.5 3 1v2a2 2 0 0 1-2 2A13 13 0 0 1 4 5.5a2 2 0 0 1 2-2Z"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linejoin="round"></path>
							</svg>
							+1 (800) 555-0142
						</a>
					</div>
				</div>
			</aside>
		</div>
	</div>
</section>

<script>
	const form = document.querySelector('#transfer-form');
	const errorSummary = document.querySelector('#form-error');
	const successPanel = document.querySelector('#form-success');

	if (form) {
		const fields = form.querySelectorAll('input, select, textarea');
		const messages = {
			fullName: 'Please enter your full name.',
			email: 'Please enter a valid email address.',
			phone: 'Please enter a phone number.',
			employeeId: 'Enter an employee ID with at least 4 letters, numbers, or hyphens.',
			currentSchool: 'Please enter your current school.',
			currentRegion: 'Please select your current district.',
			preferredSchool: 'Please enter your preferred school.',
			preferredRegion: 'Please select a preferred district.',
			role: 'Please select your role or grade level.',
			years: 'Enter a number between 0 and 50.',
			reason: 'Please add at least 20 characters about your request.',
			declaration: 'Please confirm the declaration to continue.',
		};

		let hasShownSummary = false;

		const clearError = (field) => {
			field.removeAttribute('aria-invalid');
			const error = document.getElementById(`${field.id}-error`);
			if (error) {
				error.textContent = '';
				error.classList.add('hidden');
			}
		};

		const showError = (field) => {
			field.setAttribute('aria-invalid', 'true');
			const error = document.getElementById(`${field.id}-error`);
			if (error) {
				error.textContent = messages[field.id] || field.validationMessage;
				error.classList.remove('hidden');
			}
		};

		fields.forEach((field) => {
			field.addEventListener('input', () => clearError(field));
			field.addEventListener('change', () => clearError(field));
		});

		form.addEventListener(
			'invalid',
			(event) => {
				const field = event.target;
				if (!(field instanceof HTMLElement) || !field.id) return;
				showError(field);
				if (errorSummary && !hasShownSummary) {
					errorSummary.textContent = 'Please review the highlighted fields and try again.';
					errorSummary.hidden = false;
					hasShownSummary = true;
				}
			},
			true
		);

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			hasShownSummary = false;
			if (errorSummary) errorSummary.hidden = true;
			if (successPanel) successPanel.hidden = true;

			let firstInvalid = null;
			fields.forEach((field) => {
				if (!field.validity.valid) {
					showError(field);
					if (!firstInvalid) firstInvalid = field;
				} else {
					clearError(field);
				}
			});

			if (firstInvalid) {
				if (errorSummary) {
					errorSummary.textContent = 'Please review the highlighted fields and try again.';
					errorSummary.hidden = false;
				}
				firstInvalid.focus();
				return;
			}

			const nameField = form.querySelector('#fullName');
			const firstName = nameField?.value.trim().split(' ')[0] || 'there';
			const successMessage = successPanel?.querySelector('[data-success-message]');

			if (successMessage) {
				successMessage.textContent = `Thanks, ${firstName}. Your demo application is complete — no data was sent.`;
			}

			form.reset();
			fields.forEach(clearError);

			if (successPanel) {
				successPanel.hidden = false;
				successPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
			}
		});
	}
</script>
